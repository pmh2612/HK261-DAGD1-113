# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit real credentials.

# --- Neo4j -------------------------------------------------------------
# Used by the application AND by docker-compose.yml to create the database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External APIs -----------------------------------------------------
# Optional, but gives higher rate limits: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# --- Local LLM ---------------------------------------------------------
# The model runs on our own hardware; no hosted API is used (see docs/decisions.md
# DECIDE-7). Start the runtime with `ollama serve`, then `ollama pull <model>`.
LLM_BASE_URL=http://localhost:11434
# Model tag, e.g. qwen2.5:7b-instruct. Left empty until DECIDE-7 is settled.
LLM_MODEL=

# --- Storage -----------------------------------------------------------
# Where raw/ and processed/ data live. Relative paths resolve from the repo root.
DATA_DIR=data
