# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit real credentials.

# --- Neo4j -------------------------------------------------------------
# Used by the application AND by docker-compose.yml to create the database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External APIs -----------------------------------------------------
# Optional, but gives higher rate limits: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# API key for the LLM used in entity extraction (Phase 1) and RAG (Phase 2).
LLM_API_KEY=

# --- Storage -----------------------------------------------------------
# Where raw/ and processed/ data live. Relative paths resolve from the repo root.
DATA_DIR=data
